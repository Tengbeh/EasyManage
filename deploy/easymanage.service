[Unit]
Description=EasyManage employee and payroll application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easymanage
Group=easymanage
WorkingDirectory=/workspace/easy-manage/server
EnvironmentFile=/workspace/easy-manage/server/.env
ExecStart=/usr/local/bin/node /workspace/easy-manage/server/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/easymanage

[Install]
WantedBy=multi-user.target
