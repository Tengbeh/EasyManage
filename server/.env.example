# Copy to server/.env. Never commit credentials or a real .env.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173
# Generate: openssl rand -hex 32. Required for Google sign-in and production startup.
SESSION_SECRET=
SESSION_DIR=./.sessions
# Set to 1 only behind one trusted reverse proxy (HTTPS in production).
TRUST_PROXY=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM with literal \n escapes inside quotes, or use GOOGLE_APPLICATION_CREDENTIALS instead.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# Only used when the Users worksheet is completely empty.
BOOTSTRAP_ADMIN_EMAIL=
# Optional CLIENT_DIST_PATH defaults to ../client/dist relative to server.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist
# Optional same shared local directory for every process writing this spreadsheet.
# WRITER_LOCK_DIR=/tmp/easymanage-writers
# Development seed is explicit and refuses existing business data:
# SEED_DEMO_CONFIRM=WRITE_FICTIONAL_DATA_TO_DEVELOPMENT_SHEETS
