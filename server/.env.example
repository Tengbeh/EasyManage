# Copy to server/.env. Never commit actual credentials.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=
DEFAULT_COMPANY_ID=00000000-0000-4000-8000-000000000001
# Generate a random secret of at least 32 characters, for example openssl rand -hex 32.
SESSION_SECRET=
SESSION_DIR=./.sessions
STORAGE_ROOT=./private-storage
# Set only for the deployed trusted reverse proxy topology.
TRUST_PROXY=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Optional first authorized verified account, only when the company user table is empty.
BOOTSTRAP_ADMIN_EMAIL=
# Optional: override the static frontend build directory.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist

# OPTIONAL LEGACY IMPORT / REPORTING INTEGRATION ONLY. Never used as runtime persistence.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
