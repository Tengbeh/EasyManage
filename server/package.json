{
  "name": "easymanage-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts tests/*.test.ts",
    "init-sheets": "tsx src/scripts/initialize.ts",
    "bootstrap-admin": "tsx src/scripts/bootstrap.ts",
    "seed-demo": "tsx src/scripts/seed.ts",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:bootstrap": "tsx src/scripts/bootstrap-database.ts",
    "db:import-sheets": "tsx src/scripts/import-sheets.ts",
    "test:database": "RUN_DATABASE_TESTS=1 NODE_ENV=test tsx --test tests/postgres.test.ts"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
