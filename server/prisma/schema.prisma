generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}

model Company {
  company_id String @id @db.Uuid
  name String
  currency String @default("USD") @db.VarChar(3)
  status String @default("active")
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  department Department[]
  employee Employee[]
  user User[]
  bonus Bonus[]
  penalty Penalty[]
  loan Loan[]
  loanInstallment LoanInstallment[]
  payrollRun PayrollRun[]
  payrollRow PayrollRow[]
  attendance Attendance[]
  leaveRequest LeaveRequest[]
  companySettings CompanySettings[]
  auditLog AuditLog[]
  salaryHistory SalaryHistory[]
  notificationRead NotificationRead[]
  idempotencyRecord IdempotencyRecord[]
  loanPayment LoanPayment[]
  workSchedule WorkSchedule[]
  shiftAssignment ShiftAssignment[]
  holiday Holiday[]
  attendanceCorrection AttendanceCorrection[]
  leaveType LeaveType[]
  leaveEntitlement LeaveEntitlement[]
  approvalDecision ApprovalDecision[]
  attendancePayrollInput AttendancePayrollInput[]
  leaveAttachment LeaveAttachment[]
  @@map("companies")
}

model Department {
  company_id String @db.Uuid
  department_id String @db.Uuid
  department_name String? @db.Text
  description String? @db.Text
  department_head String? @db.Text
  status String? @db.Text
  created_at DateTime? @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)
  extension_data Json @default("{}") @db.JsonB
  company Company @relation(fields: [company_id], references: [company_id], onDelete: Restrict, onUpdate: Restrict)
  reverse_Employee_department_id Employee[] @relation("Employee_department_id")
  reverse_PayrollRow_department_id PayrollRow[] @relation("PayrollRow_department_id")
  reverse_WorkSchedule_department_id WorkSchedule[] @relation("WorkSchedule_department_id")
  reverse_Holiday_department_id Holiday[] @relation("Holiday_department_id")
  @@id([company_id, department_id])
  @@unique([company_id, department_name])
  @@index([company_id, status])
  @@map("departments")
}

model Employee {
  company_id String @db.Uuid
  employee_id String @db.Uuid
  employee_number String? @db.Text
  first_name String? @db.Text
  last_name String? @db.Text
  email String? @db.Text
  phone String? @db.Text
  address String? @db.Text
  gender String? @db.Text
  position String? @db.Text
  employment_type String? @db.Text
  employment_status String? @db.Text
  payment_frequency String? @db.Text
  bank_name String? @db.Text
  account_number String? @db.Text
  emergency_contact String? @db.Text
  profile_image String? @db.Text
  notes String? @db.Text
  department_id String @db.Uuid
  date_of_birth DateTime? @db.Date
  hire_date DateTime? @db.Date
  employment_end_date DateTime? @db.Date
  basic_salary Decimal? @db.Decimal(18, 2)
  allowances Decimal? @db.Decimal(18, 2)
  created_at DateTime? @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)
  extension_data Json @default("{}") @db.JsonB
  company Company @relation(fields: [company_id], references: [company_id], onDelete: Restrict, onUpdate: Restrict)
  department_id_relation Department @relation("Employee_department_id", fields: [company_id, department_id], references: [company_id, department_id], onDelete: Restrict, onUpdate: Restrict)
  reverse_User_employee_id User[] @relation("User_employee_id")
  reverse_Bonus_employee_id Bonus[] @relation("Bonus_employee_id")
  reverse_Penalty_employee_id Penalty[] @relation("Penalty_employee_id")
  reverse_Loan_employee_id Loan[] @relation("Loan_employee_id")
  reverse_LoanInstallment_employee_id LoanInstallment[] @relation("LoanInstallment_employee_id")
  reverse_PayrollRow_employee_id PayrollRow[] @relation("PayrollRow_employee_id")
  reverse_Attendance_employee_id Attendance[] @relation("Attendance_employee_id")
  reverse_LeaveRequest_employee_id LeaveRequest[] @relation("LeaveRequest_employee_id")
  reverse_SalaryHistory_employee_id SalaryHistory[] @relation("SalaryHistory_employee_id")
  reverse_LoanPayment_employee_id LoanPayment[] @relation("LoanPayment_employee_id")
  reverse_ShiftAssignment_employee_id ShiftAssignment[] @relation("ShiftAssignment_employee_id")
  reverse_AttendanceCorrection_employee_id AttendanceCorrection[] @relation("AttendanceCorrection_employee_id")
  reverse_LeaveEntitlement_employee_id LeaveEntitlement[] @relation("LeaveEntitlement_employee_id")
  reverse_AttendancePayrollInput_employee_id AttendancePayrollInput[] @relation("AttendancePayrollInput_employee_id")
  reverse_LeaveAttachment_employee_id LeaveAttachment[] @relation("LeaveAttachment_employee_id")
  @@id([company_id, employee_id])
  @@unique([company_id, employee_number])
  @@unique([company_id, email])
  @@index([company_id, department_id, employment_status])
  @@index([company_id, hire_date])
  @@index([company_id, employment_end_date])
  @@map("employees")
}

model User {
  company_id String @db.Uuid
  user_id String @db.Uuid
  full_name String? @db.Text
  email String? @db.Text
  google_id String? @db.Text
  profile_image String? @db.Text
  role String? @db.Text
  department String? @db.Text
  status String? @db.Text
  employee_id String? @db.Uuid
  permissions Json? @db.JsonB
  last_login DateTime? @db.Timestamptz(3)
  created_at DateTime? @db.Timestamptz(3)
  updated_at DateTime? @db.Timestamptz(3)
  extension_data Json @default("{}") @db.JsonB
  company Company @relation(fields: [company_id], references: [company_id], onDelete: Restrict, onUpdate: Restrict)
  employee_id_relation Employee? @relation("User_employee_id", fields: [company_id, employee_id], references: [company_id, employee_id], onDelete: Restrict, onUpdate: Restrict)
  reverse_NotificationRead_user_id NotificationRead[] @relation("NotificationRead_user_id")
  reverse_IdempotencyRecord_user_id IdempotencyRecord[] @relation("IdempotencyRecord_user_id")
  reverse_AttendanceCorrection_requested_by AttendanceCorrection[] @relation("AttendanceCorrection_requested_by")
  reverse_ApprovalDecision_approver_id ApprovalDecision[] @relation("ApprovalDecision_approver_id")
  @@id([company_id, user_id])
  @@unique([company_id, email])
  @@unique([company_id, google_id])
  @@unique([company_id, employee_id])
  @@index([company_id, role, status])
  @@map("users")
}

